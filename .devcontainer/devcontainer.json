{
	"name": "homelab-k3s-cluster",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
	    "ghcr.io/guiyomh/features/vim": {}
	},
    "mounts": [
        "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached"
    ],
    "postCreateCommand": "mise trust && mise install"
    
